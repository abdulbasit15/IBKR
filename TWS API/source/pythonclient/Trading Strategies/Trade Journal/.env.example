# This file is OPTIONAL. By default the journal uses the `claude` CLI (Claude
# Code) with your existing login, so you do NOT need an API key.
#
# Copy this to ".env" only if you want to change defaults. The .env file is read
# automatically when you run the journal.

# --- Default (no API key): use your Claude Code login via the `claude` CLI ----
# Model alias for the CLI backend: "sonnet" (default) or "opus" for max depth.
# JOURNAL_CLI_MODEL=sonnet

# Force a backend: "auto" (default), "cli", or "api".
# JOURNAL_AI_BACKEND=auto

# --- Optional: use the HTTP API instead (only if you have a key) --------------
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# JOURNAL_MODEL=claude-opus-5
