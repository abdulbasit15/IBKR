//@version=6
// ─────────────────────────────────────────────────────────────────────────────
//  David Paul Stop-Hunt – BACKTEST STRATEGY
//  Same signal logic as the "AB - DP stop hunt" indicator (Sweep & reclaim mode).
//
//  Fills: signal on bar close → market entry at next bar's open. Stop and
//  target are attached at once as bracket orders. Partial exit + breakeven +
//  optional swing trail. Flattens at end of session. Daily loss limit counts a
//  trade as a loss when it loses ≥ 0.5R after costs.
//
//  Defaults for CME micros at IBKR: $0.62 per contract per side, 1 tick
//  slippage per market/stop fill. Change them in Settings → Properties.
// ─────────────────────────────────────────────────────────────────────────────
strategy("AB - DP stop hunt Strategy", shorttitle = "AB - DP stop hunt Strategy", overlay = true, initial_capital = 10000, currency = currency.USD, pyramiding = 0, default_qty_type = strategy.fixed, default_qty_value = 1, commission_type = strategy.commission.cash_per_contract, commission_value = 0.62, slippage = 1, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

TZ = "America/New_York"

// ───── Inputs ─────
G_BT = "Backtest & sizing"
int    startTime = input.time(timestamp("2025-01-01 00:00"), "Start date", group = G_BT)
string sizing    = input.string("Risk $ per trade", "Position sizing", options = ["Fixed contracts", "Risk $ per trade"], group = G_BT)
int    fixedQty  = input.int(1, "Fixed contracts", minval = 1, group = G_BT)
float  riskUsd   = input.float(100.0, "Risk $ per trade", minval = 1, group = G_BT, tooltip = "Contracts = floor(risk $ ÷ (stop distance × point value)). If even 1 contract risks more than this, the trade is skipped.")
int    maxQty    = input.int(10, "Max contracts", minval = 1, group = G_BT)

G_LVL = "Stop pools (Rule 3)"
int    pivLen         = input.int(5, "Swing strength (bars each side)", minval = 1, group = G_LVL)
string bufType        = input.string("ATR", "Stop buffer type", options = ["ATR", "Ticks"], group = G_LVL)
float  bufAtrMul      = input.float(0.10, "Buffer – ATR multiple", minval = 0.0, step = 0.05, group = G_LVL)
int    bufTicks       = input.int(2, "Buffer – ticks", minval = 0, group = G_LVL)
int    maxLevels      = input.int(6, "Max live pools per side", minval = 1, maxval = 50, group = G_LVL)
int    maxAge         = input.int(150, "Expire pool after N bars", minval = 10, group = G_LVL)
bool   poolsOvernight = input.bool(true, "Build pools from overnight swings too", group = G_LVL)

G_TR = "Trend filter (Rule 2)"
bool   useTrend = input.bool(true, "Only trade with the longer-term trend", group = G_TR)
string trendTf  = input.timeframe("60", "Trend timeframe", group = G_TR, tooltip = "Must be HIGHER than the chart.")
int    lenMid   = input.int(55, "Mid EMA", minval = 2, group = G_TR)
int    lenSlow  = input.int(89, "Slow EMA", minval = 2, group = G_TR)
float  minSep   = input.float(0.25, "Min 55/89 EMA gap (× trend-TF ATR)", minval = 0.0, step = 0.05, group = G_TR)
bool   usePull  = input.bool(true, "Require short-term pullback against the trend", group = G_TR)
int    lenFast  = input.int(21, "Fast EMA (chart TF)", minval = 2, group = G_TR)

G_EN = "Entry & management"
int    reclaimBars = input.int(2, "Bars allowed to reclaim the level", minval = 0, maxval = 20, group = G_EN)
float  rrTarget    = input.float(2.0, "Final target (R multiple, 0 = none)", minval = 0.0, step = 0.5, group = G_EN)
string mgmt        = input.string("Breakeven at trigger", "Stop management", options = ["None", "Breakeven at trigger", "Breakeven + swing trail"], group = G_EN)
float  tp1R        = input.float(1.0, "Partial / breakeven trigger (R)", minval = 0.1, step = 0.1, group = G_EN)
float  tp1Pct      = input.float(50, "Partial exit % at trigger (0 = none)", minval = 0, maxval = 99, group = G_EN, tooltip = "Needs 2+ contracts, otherwise ignored.")
int    trailLen    = input.int(5, "Swing trail lookback (bars)", minval = 1, group = G_EN)

G_RULE = "Session & discipline rules"
bool   useSess    = input.bool(true, "Only trade inside entry window (New York time)", group = G_RULE)
string entrySess  = input.session("0930-1545", "Entry window", group = G_RULE)
string flatSess   = input.session("1550-1600", "Flatten window", group = G_RULE)
bool   useBlack   = input.bool(false, "Use daily blackout window", group = G_RULE)
string blackSess  = input.session("1355-1415", "Blackout window", group = G_RULE)
bool   onePerArea = input.bool(true, "One attempt per area", group = G_RULE)
int    maxLosses  = input.int(2, "Max losing trades per day (0 = off)", minval = 0, group = G_RULE)

G_VOL = "Volume"
bool   useVol  = input.bool(false, "Require above-average volume on the sweep bar", group = G_VOL)
int    volLen  = input.int(89, "Volume average length", minval = 2, group = G_VOL)
float  volMult = input.float(1.5, "Volume multiple", minval = 0.1, step = 0.1, group = G_VOL)

G_VIS = "Display"
bool  showPools   = input.bool(true, "Draw stop pools", group = G_VIS)
color colLowPool  = input.color(color.new(color.teal, 80), "Sell-stop pool", group = G_VIS)
color colHighPool = input.color(color.new(color.orange, 80), "Buy-stop pool", group = G_VIS)
color colSwept    = input.color(color.new(color.gray, 85), "Swept pool", group = G_VIS)

// ───── Core series ─────
bool  intraday  = timeframe.isintraday
float atr       = ta.atr(14)
float buf       = bufType == "ATR" ? atr * bufAtrMul : bufTicks * syminfo.mintick
float emaF      = ta.ema(close, lenFast)
bool  volOK     = volume > ta.sma(volume, volLen) * volMult
bool  pullDown  = close < emaF or emaF < emaF[1]
bool  pullUp    = close > emaF or emaF > emaF[1]
float trailLow  = ta.lowest(low, trailLen)
float trailHigh = ta.highest(high, trailLen)

bool sessBar = intraday and not na(time(timeframe.period, entrySess, TZ))
bool inEntry = not useSess or not intraday or sessBar
bool inFlat  = useSess and intraday and not na(time(timeframe.period, flatSess, TZ))
bool inBlack = useBlack and intraday and not na(time(timeframe.period, blackSess, TZ))
bool inDate  = time >= startTime

// ───── Trend (Rule 2) ─────
trendData(int off) =>
    float m   = ta.ema(close, lenMid)
    float s   = ta.ema(close, lenSlow)
    float a   = ta.atr(14)
    bool  sep = math.abs(m - s) >= minSep * a
    int   d   = close > s and m > s and s > s[1] and sep ? 1 : close < s and m < s and s < s[1] and sep ? -1 : 0
    [m[off], s[off], d[off]]

bool htfOn = trendTf != "" and trendTf != timeframe.period
[mCh, sCh, dCh] = trendData(0)
[mHt, sHt, dHt] = request.security(syminfo.tickerid, trendTf, trendData(1), lookahead = barmerge.lookahead_on)
float tMid  = htfOn ? mHt : mCh
float tSlow = htfOn ? sHt : sCh
int   trend = htfOn ? dHt : dCh

// ───── Stop pools (Rule 3) ─────
type Pool
    float level
    float stopPx
    int   bornBar
    box   zone

var array<Pool> lowPools  = array.new<Pool>()
var array<Pool> highPools = array.new<Pool>()

scanPools(array<Pool> pools, bool isLow) =>
    float hitLevel = na
    float hitStop  = na
    int n = pools.size()
    if n > 0
        for i = n - 1 to 0
            Pool p = pools.get(i)
            bool swept   = isLow ? low <= p.stopPx : high >= p.stopPx
            bool expired = bar_index - p.bornBar > maxAge
            if swept
                if not na(p.zone)
                    p.zone.set_right(bar_index)
                    p.zone.set_bgcolor(colSwept)
                    p.zone.set_border_color(colSwept)
                bool further = na(hitLevel) or (isLow ? p.level < hitLevel : p.level > hitLevel)
                if further
                    hitLevel := p.level
                    hitStop  := p.stopPx
                pools.remove(i)
            else if expired
                if not na(p.zone)
                    p.zone.delete()
                pools.remove(i)
            else if not na(p.zone)
                p.zone.set_right(bar_index)
    [hitLevel, hitStop]

[sweptLow, sweptLowStop]   = scanPools(lowPools, true)
[sweptHigh, sweptHighStop] = scanPools(highPools, false)

float pl     = ta.pivotlow(low, pivLen, pivLen)
float ph     = ta.pivothigh(high, pivLen, pivLen)
bool  poolOK = poolsOvernight or not intraday or sessBar[pivLen]

if not na(pl) and not na(buf) and poolOK
    float sp = pl - buf
    box b = showPools ? box.new(bar_index - pivLen, pl, bar_index, sp, border_color = color.new(colLowPool, 30), bgcolor = colLowPool) : na
    lowPools.unshift(Pool.new(pl, sp, bar_index - pivLen, b))
    if lowPools.size() > maxLevels
        Pool old = lowPools.pop()
        if not na(old.zone)
            old.zone.delete()

if not na(ph) and not na(buf) and poolOK
    float sp = ph + buf
    box b = showPools ? box.new(bar_index - pivLen, sp, bar_index, ph, border_color = color.new(colHighPool, 30), bgcolor = colHighPool) : na
    highPools.unshift(Pool.new(ph, sp, bar_index - pivLen, b))
    if highPools.size() > maxLevels
        Pool old = highPools.pop()
        if not na(old.zone)
            old.zone.delete()

// ───── One attempt per area ─────
var bool lockLong     = false
var bool lockShort    = false
var int  lastLongBar  = na
var int  lastShortBar = na
if not na(pl) and not na(lastLongBar) and bar_index - pivLen > lastLongBar
    lockLong := false
if not na(ph) and not na(lastShortBar) and bar_index - pivLen > lastShortBar
    lockShort := false

// ───── Trade bookkeeping ─────
var int   dayLosses  = 0
var bool  tradeLive  = false
var int   sigBar     = na
var float netAtSig   = 0.0
var int   ctAtSig    = 0
var float riskPlanUsd = 0.0
var int   tDir   = 0
var float tEntry = na
var float tRisk  = na
var float tStop  = na
var float tTgt   = na
var int   tQty   = 0
var bool  tSplit = false
var bool  atBE   = false

if timeframe.change("D")
    dayLosses := 0

// Finished trade? (flat again after at least one closed fill)
if tradeLive and strategy.position_size == 0
    if strategy.closedtrades > ctAtSig
        float pnl = strategy.netprofit - netAtSig
        if pnl <= -0.5 * riskPlanUsd
            dayLosses += 1
        tradeLive := false
        tDir := 0
    else if bar_index - sigBar > 2
        tradeLive := false   // entry never filled
        tDir := 0

// Manage open position
if strategy.position_size != 0 and tDir != 0
    float avg = strategy.position_avg_price
    float fav = tDir == 1 ? high - tEntry : tEntry - low
    if mgmt != "None" and not atBE and fav >= tp1R * tRisk
        tStop := tDir == 1 ? math.max(tStop, avg) : math.min(tStop, avg)
        atBE  := true
    if mgmt == "Breakeven + swing trail" and atBE
        tStop := tDir == 1 ? math.max(tStop, trailLow - buf) : math.min(tStop, trailHigh + buf)
    string eid = tDir == 1 ? "Long" : "Short"
    if tSplit and math.abs(strategy.position_size) >= tQty
        strategy.exit(tDir == 1 ? "L-TP1" : "S-TP1", eid, qty_percent = tp1Pct, stop = tStop, limit = tEntry + tDir * tp1R * tRisk)
    strategy.exit(tDir == 1 ? "L-Run" : "S-Run", eid, stop = tStop, limit = tTgt)
    if inFlat
        strategy.close_all(comment = "EOD")

// ───── Setup state ─────
var int   lBar     = na
var float lLevel   = na
var float lExtreme = na
var bool  lVolOK   = false
var bool  lPullOK  = false

var int   sBar     = na
var float sLevel   = na
var float sExtreme = na
var bool  sVolOK   = false
var bool  sPullOK  = false

if not na(sweptLow)
    lBar     := bar_index
    lLevel   := sweptLow
    lExtreme := low
    lVolOK   := volOK
    lPullOK  := pullDown
else if not na(lBar)
    lExtreme := math.min(lExtreme, low)

if not na(sweptHigh)
    sBar     := bar_index
    sLevel   := sweptHigh
    sExtreme := high
    sVolOK   := volOK
    sPullOK  := pullUp
else if not na(sBar)
    sExtreme := math.max(sExtreme, high)

// ───── Signals ─────
bool stopDay  = maxLosses > 0 and dayLosses >= maxLosses
bool flatNow  = strategy.position_size == 0 and not tradeLive
bool canTrade = inDate and inEntry and not inBlack and not inFlat and not stopDay and flatNow

bool lLive   = not na(lBar) and bar_index - lBar <= reclaimBars
bool lFilt   = (not useTrend or trend == 1) and (not usePull or lPullOK) and (not useVol or lVolOK)
bool longSig = canTrade and lLive and lFilt and close > lLevel and (not onePerArea or not lockLong)

bool sLive    = not na(sBar) and bar_index - sBar <= reclaimBars
bool sFilt    = (not useTrend or trend == -1) and (not usePull or sPullOK) and (not useVol or sVolOK)
bool shortSig = canTrade and sLive and sFilt and close < sLevel and (not onePerArea or not lockShort) and not longSig

sizeFor(float riskPts) =>
    int q = 0
    if riskPts > 0
        q := sizing == "Fixed contracts" ? fixedQty : math.min(maxQty, int(math.floor(riskUsd / (riskPts * syminfo.pointvalue))))
    q

if longSig or shortSig
    int   dir = longSig ? 1 : -1
    float e   = close
    float st  = dir == 1 ? lExtreme - buf : sExtreme + buf
    float rp  = math.abs(e - st)
    int   q   = sizeFor(rp)
    if q >= 1
        string eid = dir == 1 ? "Long" : "Short"
        strategy.entry(eid, dir == 1 ? strategy.long : strategy.short, q)
        tDir   := dir
        tEntry := e
        tRisk  := rp
        tStop  := st
        tTgt   := rrTarget > 0 ? e + dir * rrTarget * rp : na
        tQty   := q
        tSplit := tp1Pct > 0 and q >= 2
        atBE   := false
        if tSplit
            strategy.exit(dir == 1 ? "L-TP1" : "S-TP1", eid, qty_percent = tp1Pct, stop = st, limit = e + dir * tp1R * rp)
        strategy.exit(dir == 1 ? "L-Run" : "S-Run", eid, stop = st, limit = tTgt)
        tradeLive   := true
        sigBar      := bar_index
        netAtSig    := strategy.netprofit
        ctAtSig     := strategy.closedtrades
        riskPlanUsd := q * rp * syminfo.pointvalue
        if dir == 1
            lockLong    := onePerArea
            lastLongBar := bar_index
        else
            lockShort    := onePerArea
            lastShortBar := bar_index

if longSig or (not na(lBar) and bar_index - lBar >= reclaimBars)
    lBar := na
if shortSig or (not na(sBar) and bar_index - sBar >= reclaimBars)
    sBar := na

// ───── Plots ─────
bool inPos = strategy.position_size != 0
plot(emaF, "Fast EMA", color.new(color.blue, 30))
plot(tMid, "Mid EMA (trend TF)", color.new(color.purple, 30), style = plot.style_stepline)
plot(tSlow, "Slow EMA (trend TF)", color.new(color.red, 20), linewidth = 2, style = plot.style_stepline)
plot(inPos ? tStop : na, "Active stop", color.red, style = plot.style_linebr)
plot(inPos ? tTgt : na, "Target", color.green, style = plot.style_linebr)
bgcolor(stopDay and intraday ? color.new(color.red, 94) : na, title = "Daily loss limit hit")
